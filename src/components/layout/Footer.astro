---
import EmailIcon from "../icons/EmailIcon.astro";
import PhoneIcon from "../icons/PhoneIcon.astro";
import LocationPin from "../icons/LocationPin.astro";
import FacebookIcon from "../icons/FacebookIcon.astro";
import InstagramIcon from "../icons/InstagramIcon.astro";

const quickLinks = [
  { href: "#", label: "Home" },
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#locations", label: "Locations" },
  { href: "#contact", label: "Contact" },
];

const services = [
  "Well-Woman Exams",
  "Prenatal Care",
  "Menopause Support",
  "Birth Control Counseling",
  "Hormonal Health",
  "Infertility Evaluations",
];

const currentYear = new Date().getFullYear();
---

<footer
  class="relative mt-24 border-t border-[rgb(var(--color-border))/0.12] bg-[rgb(var(--color-surface))] text-[rgb(var(--color-text))] transition-colors duration-300"
>
  <div class="footer-pattern"></div>

  <div class="container-shell relative z-10 py-14 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_0.8fr_1fr_1fr] lg:gap-8">
      <div>
        <a
          href="/"
          class="group inline-flex shrink-0 items-center gap-3"
          aria-label="Carlos Rodriguez Ortiz MD, PA home"
        >
          <img src="/images/logo-dr.webp" alt="Clinic Logo" class="h-15 w-15" />

          <span class="flex flex-col leading-none">
            <span
              class="font-[var(--font-display)] text-xl font-semibold tracking-tight text-[rgb(var(--color-text))]"
            >
              Carlos Rodriguez Ortiz MD, PA
            </span>
            <span
              class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-[rgb(var(--color-text-secondary))]"
            >
              Obstetrics & Gynecology
            </span>
          </span>
        </a>

        <p class="mt-5 max-w-md text-sm leading-7 text-[rgb(var(--color-text-secondary))]">
          Compassionate women’s healthcare with a more expressive, welcoming,
          and elevated experience for preventive care, pregnancy, hormonal
          wellness, and every stage of life.
        </p>

        <div id="social-media" class="mt-6 flex flex-row gap-4">
          <a
            href="#"
            class="text-[rgb(var(--color-text-secondary))] transition-colors duration-200 hover:text-[rgb(var(--color-text))] hover:scale-110"
          >
            <FacebookIcon />
          </a>
          <a
            href="#"
            class="text-[rgb(var(--color-text-secondary))] transition-colors duration-200 hover:text-[rgb(var(--color-text))] hover:scale-110"
          >
            <InstagramIcon />
          </a>
        </div>
      </div>

      <div>
        <h3 class="font-[var(--font-display)] text-xl font-semibold">Quick Links</h3>
        <ul class="mt-4 space-y-3">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm font-medium text-[rgb(var(--color-text-secondary))] transition-colors duration-200 hover:text-[rgb(var(--color-text))]"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-[var(--font-display)] text-xl font-semibold">Services</h3>
        <ul class="mt-4 space-y-3">
          {
            services.map((service) => (
              <li class="text-sm font-medium text-[rgb(var(--color-text-secondary))]">
                {service}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-[var(--font-display)] text-xl font-semibold">Contact</h3>
        <ul class="mt-4 space-y-4 text-sm font-medium text-[rgb(var(--color-text-secondary))]">
          <li>
            <PhoneIcon class="mr-2 inline h-5 w-5" />
            <a
              href="tel:7863322922"
              class="transition-colors duration-200 hover:text-[rgb(var(--color-text))]"
            >
              (786) 332-2922
            </a>
          </li>
          <li>
            <EmailIcon class="mr-2 inline h-5 w-5" />
            <a
              href="mailto:drrodriguez@test.com"
              class="transition-colors duration-200 hover:text-[rgb(var(--color-text))]"
            >
              drrodriguez@test.com
            </a>
          </li>
          <li>
            <LocationPin class="mr-2 inline h-5 w-5" />
            <a href="#">Miami</a> · <a href="#">Hialeah</a> · <a href="#">Kendall</a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-[rgb(var(--color-border))/0.12] pt-6 text-sm text-[rgb(var(--color-text-secondary))] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {currentYear} Powered by
        <a
          href="https://thesmartsolution.net"
          class="transition-colors duration-200 hover:text-[rgb(var(--color-text))]"
        >
          SMART Solutions
        </a>.
        All rights reserved.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="#"
          class="transition-colors duration-200 hover:text-[rgb(var(--color-text))]"
        >
          Privacy Policy
        </a>
        <a
          href="#"
          class="transition-colors duration-200 hover:text-[rgb(var(--color-text))]"
        >
          Terms
        </a>
      </div>
    </div>
  </div>
</footer>