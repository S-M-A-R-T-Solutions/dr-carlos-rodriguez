---
const navLinks = [
  { href: "/#main-content", label: "Home" },
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#locations", label: "Locations" },
  { href: "#contact", label: "Contact" },
];

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header
  class="sticky top-0 z-50 border-b border-black/5 bg-[rgb(var(--color-surface))/0.92] backdrop-blur-xl transition-colors duration-300 dark:border-white/10 dark:bg-[rgb(var(--color-surface))/0.82]"
>
  <div class="container-shell flex items-center justify-between gap-4 py-4">
    <a
      href="/"
      class="group inline-flex min-w-0 items-center gap-2 sm:gap-3"
      aria-label="Carlos Rodriguez Ortiz MD, PA home"
    >
      <img src="/images/logo-dr.webp" alt="Carlos Rodriguez Ortiz MD, PA logo" class="h-10 w-10 shrink-0 sm:h-13 sm:w-13" />

      <span class="min-w-0 flex flex-col leading-tight">
        <span
          class="font-[var(--font-display)] text-sm font-extrabold tracking-tight sm:text-lg text-[rgb(var(--color-text))]"
        >
          Carlos Rodriguez Ortiz MD, PA
        </span>
        <span
          class="hidden sm:block text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-black/55 dark:text-[rgb(var(--color-text-secondary))]"
        >
          Obstetrics & Gynecology
        </span>
      </span>
    </a>

    <nav
      aria-label="Primary"
      data-desktop-navigation
      class="hidden items-center gap-1 rounded-full border border-black/8 bg-[rgb(var(--color-surface))] px-2 py-2 shadow-soft xl:flex dark:border-white/10 dark:bg-white/5 dark:shadow-none"
    >
      {
        navLinks.map((link) => {
          const active = isActive(link.href);

          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-full px-4 py-2 font-[var(--font-display)] text-sm font-bold transition-all duration-200",
                active
                  ? "bg-[rgb(var(--color-surface-soft))] text-[rgb(var(--color-text))] shadow-sm ring-1 ring-black/8 dark:bg-white/10 dark:ring-white/10"
                  : "text-[rgb(var(--color-text-secondary))] hover:bg-[rgb(var(--color-surface-soft))] hover:text-[rgb(var(--color-text))] dark:hover:bg-white/8 dark:hover:text-white",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <button
        type="button"
        class="group inline-flex h-11 w-11 items-center justify-center rounded-full border border-black/10 bg-[rgb(var(--color-surface))] text-[rgb(var(--color-text))] shadow-soft transition hover:-translate-y-0.5 hover:border-black/15 hover:bg-[rgb(var(--color-surface-soft))] dark:border-white/10 dark:bg-white/5 dark:text-white dark:shadow-none dark:hover:bg-white/10"
        aria-label="Toggle dark mode"
        data-theme-toggle
      >
        <span class="sr-only">Toggle dark mode</span>

        <svg
          data-theme-icon="sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          class="h-5 w-5 scale-100 opacity-100 transition-all duration-300 dark:scale-0 dark:opacity-0"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2.5M12 19.5V22M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12H22M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"
          ></path>
        </svg>

        <svg
          data-theme-icon="moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          class="absolute h-5 w-5 scale-0 opacity-0 transition-all duration-300 dark:scale-100 dark:opacity-100"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <details data-mobile-navigation class="xl:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-black/10 bg-[rgb(var(--color-surface))] text-[rgb(var(--color-text))] shadow-soft [&::-webkit-details-marker]:hidden dark:border-white/10 dark:bg-white/5"
          aria-label="Navigation menu"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>
        <nav
          aria-label="Mobile primary"
          class="absolute inset-x-4 top-full mt-2 max-h-[calc(100dvh-8rem)] overflow-y-auto rounded-2xl border border-black/10 bg-[rgb(var(--color-surface))] p-2 shadow-card dark:border-white/10"
        >
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="block rounded-xl px-4 py-3 font-[var(--font-display)] font-bold text-[rgb(var(--color-text))] hover:bg-[rgb(var(--color-surface-soft))]"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </details>

      <a
        href="/#contact"
        data-desktop-visit
        class="hidden rounded-full btn-primary px-5 py-3 font-[var(--font-display)] text-sm font-extrabold xl:inline-flex"
      >
        Request Visit
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const doc = document.documentElement;
    const themeButton = document.querySelector("[data-theme-toggle]");

    const getStoredTheme = () => {
      const saved = localStorage.getItem("clinic-theme");
      if (saved === "light" || saved === "dark") return saved;

      if (doc.classList.contains("dark")) return "dark";
      return "light";
    };

    const applyTheme = (theme) => {
      doc.dataset.theme = theme;
      doc.classList.remove("light", "dark");
      doc.classList.add(theme);
      localStorage.setItem("clinic-theme", theme);
    };

    const getTheme = () => {
      if (doc.classList.contains("dark")) return "dark";
      return "light";
    };

    const syncThemeButton = () => {
      if (!themeButton) return;
      themeButton.setAttribute(
        "aria-label",
        getTheme() === "dark" ? "Switch to light mode" : "Switch to dark mode",
      );
    };

    applyTheme(getStoredTheme());
    syncThemeButton();

    themeButton?.addEventListener("click", () => {
      const nextTheme = getTheme() === "dark" ? "light" : "dark";

      if (typeof window.__setPreferredTheme === "function") {
        window.__setPreferredTheme(nextTheme);
      } else {
        applyTheme(nextTheme);
      }

      syncThemeButton();
    });
  })();
</script>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-mobile-navigation]");
  const toggle = menu?.querySelector("summary");

  if (menu && toggle) {
    const closeMenu = () => {
      menu.open = false;
    };

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        event.preventDefault();
        closeMenu();
        toggle.focus();
      }
    });

    menu.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        const target = document.getElementById(new URL(link.href).hash.slice(1));
        if (!target) return;

        // Keep native fragment navigation/history, but do not leave keyboard
        // focus on a link that is about to become hidden.
        const hadTabindex = target.hasAttribute("tabindex");
        if (!hadTabindex) {
          target.setAttribute("tabindex", "-1");
          target.addEventListener("blur", () => target.removeAttribute("tabindex"), { once: true });
        }
        closeMenu();
        target.focus({ preventScroll: true });
      });
    });

    const desktop = window.matchMedia("(min-width: 80rem)");
    desktop.addEventListener("change", () => {
      const active = document.activeElement;
      closeMenu();
      if (!(active instanceof HTMLElement)) return;

      if (desktop.matches && menu.contains(active)) {
        const href = active.getAttribute("href");
        const links = document.querySelectorAll<HTMLAnchorElement>("[data-desktop-navigation] a");
        const destination = Array.from(links).find((link) => link.getAttribute("href") === href) || links[0];
        destination?.focus();
      } else if (!desktop.matches) {
        const desktopControls = document.querySelectorAll("[data-desktop-navigation], [data-desktop-visit]");
        if (Array.from(desktopControls).some((control) => control.contains(active))) {
          toggle.focus();
        }
      }
    });

    window.addEventListener("pageshow", (event) => {
      if (event.persisted && menu.open) {
        const hadFocus = menu.contains(document.activeElement);
        closeMenu();
        if (hadFocus) toggle.focus();
      }
    });
  }
</script>
