---
const navLinks = [
  { href: "#", label: "Home" },
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#locations", label: "Locations" },
  { href: "#contact", label: "Contact" },
];
---

<header
  class="sticky top-0 z-50 border-b border-[rgb(var(--color-border))/0.12] bg-[rgb(var(--color-surface))/0.72] backdrop-blur-2xl transition-colors duration-300"
>
  <div class="container-shell flex items-center justify-between gap-4 py-4">
    <a
      href="/"
      class="group inline-flex shrink-0 items-center gap-3"
      aria-label="Carlos Rodriguez Ortiz MD, PA home"
    >
      <img src="/images/logo-dr.webp" alt="Clinic Logo" class="h-13 w-13" />

      <span class="flex flex-col leading-none">
        <span
          class="font-[var(--font-display)] text-xl font-semibold tracking-tight text-[rgb(var(--color-text))]"
        >
          Carlos Rodriguez Ortiz MD, PA
        </span>
        <span
          class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-[rgb(var(--color-text-secondary))]"
        >
          Obstetrics & Gynecology
        </span>
      </span>
    </a>

    <nav
      class="hidden items-center gap-1 rounded-full border border-[rgb(var(--color-border))/0.14] bg-[rgb(var(--color-surface))/0.88] px-2 py-2 shadow-soft lg:flex"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-4 py-2 text-sm font-semibold text-[rgb(var(--color-text-secondary))] transition-all duration-200 hover:bg-[rgb(var(--color-surface-soft))] hover:text-[rgb(var(--color-text))]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        class="group relative inline-flex h-11 w-11 items-center justify-center rounded-full border border-[rgb(var(--color-border))/0.16] bg-[rgb(var(--color-surface))] text-[rgb(var(--color-text))] shadow-soft transition hover:-translate-y-0.5 hover:bg-[rgb(var(--color-surface-soft))]"
        aria-label="Toggle dark mode"
        data-theme-toggle
      >
        <span class="sr-only">Toggle dark mode</span>

        <svg
          data-theme-icon="sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          class="h-5 w-5 scale-100 opacity-100 transition-all duration-300 dark:scale-0 dark:opacity-0"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2.5M12 19.5V22M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12H22M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"
          ></path>
        </svg>

        <svg
          data-theme-icon="moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          class="absolute h-5 w-5 scale-0 opacity-0 transition-all duration-300 dark:scale-100 dark:opacity-100"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <a
        href="#contact"
        class="hidden rounded-full btn-primary px-5 py-3 text-sm font-bold uppercase tracking-[0.14em] lg:inline-flex"
      >
        Request Visit
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const doc = document.documentElement;
    const themeButton = document.querySelector("[data-theme-toggle]");

    const getTheme = () => {
      if (doc.classList.contains("dark")) return "dark";
      return "light";
    };

    const syncThemeButton = () => {
      if (!themeButton) return;
      themeButton.setAttribute(
        "aria-label",
        getTheme() === "dark" ? "Switch to light mode" : "Switch to dark mode",
      );
    };

    syncThemeButton();

    themeButton?.addEventListener("click", () => {
      const nextTheme = getTheme() === "dark" ? "light" : "dark";

      if (typeof window.__setPreferredTheme === "function") {
        window.__setPreferredTheme(nextTheme);
      } else {
        doc.dataset.theme = nextTheme;
        doc.classList.remove("light", "dark");
        doc.classList.add(nextTheme);
        localStorage.setItem("clinic-theme", nextTheme);
      }

      syncThemeButton();
    });
  })();
</script>