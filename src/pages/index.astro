---
import MainLayout from "../layouts/MainLayout.astro";

const services = [
  {
    title: "Well-Woman Exams",
    description:
      "Routine preventive visits focused on screenings, wellness, and long-term gynecologic health for your peace of mind.",
    image: "/images/well-woman-exams.webp",
  },
  {
    title: "Birth Control",
    description:
      "Personalized contraceptive counseling to help patients choose the option that fits their lifestyle and goals.",
    image: "/images/birth-control.webp",
  },
  {
    title: "Pap Smears",
    description:
      "Screening and preventive care designed to support cervical health and early detection.",
    image: "/images/pap-smears.webp",
  },
  {
    title: "Abnormal Bleeding",
    description:
      "Comprehensive evaluation and treatment options for irregular or heavy menstrual bleeding.",
    image: "/images/abnormal-bleeding.webp",
  },
  {
    title: "Ovarian Cysts",
    description:
      "Careful diagnosis and treatment planning for ovarian cysts and related symptoms.",
    image: "/images/ovarian-cysts.webp",
  },
  {
    title: "Endometriosis",
    description:
      "Supportive, individualized care to help manage pain, symptoms, and long-term reproductive health.",
    image: "/images/endometriosis.webp",
  },
  {
    title: "Family Planning",
    description:
      "Guidance and care for patients preparing for pregnancy or planning their reproductive future.",
    image: "/images/family-planning.webp",
  },
  {
    title: "Infertility Services",
    description:
      "Evaluations and next-step guidance for patients seeking support with fertility concerns.",
    image: "/images/infertility-services.webp",
  },
  {
    title: "Prenatal Care",
    description:
      "Attentive pregnancy care focused on the health, comfort, and confidence of both mother and baby.",
    image: "/images/prenatal-care.webp",
  },
  {
    title: "Childbirth Support",
    description:
      "Experienced obstetric care through delivery with a calm and supportive approach.",
    image: "/images/birth-support.webp",
  },
  {
    title: "Menopause Support",
    description:
      "Care plans that help patients navigate hormonal changes, symptoms, and wellness during menopause.",
    image: "/images/menopause-support.webp",
  },
  {
    title: "Hormonal Health",
    description:
      "Evaluation and treatment for hormone-related concerns that affect daily health and quality of life.",
    image: "/images/hormone-health.webp",
  },
];

const highlights = [
  {
    title: "Patient-focused care",
    description:
      "An integrative, personal approach that supports every patient in a warm and attentive environment.",
  },
  {
    title: "Comprehensive women’s health",
    description:
      "Care through every stage of life, from the first period to pregnancy, childbirth, menopause, and beyond.",
  },
  {
    title: "Se habla español",
    description:
      "Bilingual support to help patients feel informed, comfortable, and confident in every step of care.",
  },
];

const stats = [
  { value: "3", label: "South Florida locations" },
  { value: "12+", label: "Women’s health services" },
  { value: "Integrative", label: "Patient-first approach" },
];

const locations = [
  {
    name: "Miami",
    address: "3683 S Miami Ave., Suite 400",
    cityState: "Miami, FL",
    zipCode: "33133",
    mapEmbed:
      "https://www.google.com/maps?q=3683+S+Miami+Ave+Suite+400+Miami+FL+33133&output=embed",
  },
  {
    name: "Hialeah",
    address: "705 E 26th St.",
    cityState: "Hialeah, FL",
    zipCode: "33013",
    mapEmbed:
      "https://www.google.com/maps?q=705+E+26th+St+Hialeah+FL+33013&output=embed",
  },
  {
    name: "Kendall Regional Hospital",
    address: "11760 Bird Rd, Suite 734",
    cityState: "Miami, FL",
    zipCode: "33175",
    mapEmbed:
      "https://www.google.com/maps?q=11760+Bird+Rd+Suite+734+Miami+FL+33175&output=embed",
  },
];

const insuranceProviders = [
  { name: "Aetna", src: "/images/insurances/aetna.webp" },
  {
    name: "AmeriHealth Caritas",
    src: "/images/insurances/amerihealth-caritas.webp",
  },
  {
    name: "Anthem: Blue Cross Blue Shield",
    src: "/images/insurances/anthem-blue-cross-blue-shield.webp",
  },
  { name: "AvMed", src: "/images/insurances/avmed.webp" },
  { name: "Cigna", src: "/images/insurances/cigna.webp" },
  {
    name: "United Healthcare",
    src: "/images/insurances/united-healthcare.webp",
  },
  { name: "Bright Health", src: "/images/insurances/bright-health.webp" },
  {
    name: "Molina Healthcare",
    src: "/images/insurances/molina-healthcare.webp",
  },
  { name: "Oscar", src: "/images/insurances/oscar.webp" },
];
---

<MainLayout
  title="Carlos Rodriguez Ortiz MD, PA | Obstetrics & Gynecology"
  description="Compassionate obstetrics and gynecology care in Miami, Hialeah, and Kendall."
>
  <section class="relative overflow-hidden pt-8 lg:pt-10">
    <div class="container-shell py-12 lg:py-20">
      <div class="grid gap-8 lg:grid-cols-[1.02fr_0.98fr] lg:items-center">
        <div class="relative z-10">
          <span class="eyebrow-chip">
            Obstetrics &amp; Gynecology in Miami, Hialeah, and Kendall
          </span>

          <h1
            class="mt-6 max-w-3xl font-[var(--font-display)] text-5xl font-semibold leading-[0.98] tracking-[-0.04em] sm:text-6xl lg:text-7xl"
          >
            A calmer, more elevated experience in women’s healthcare.
          </h1>

          <p class="text-muted mt-6 max-w-2xl text-lg leading-8">
            Carlos Rodriguez Ortiz MD, PA, and his team provide compassionate
            obstetrics and gynecology care with a patient-focused approach that
            blends expertise, warmth, and long-term wellness support.
          </p>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href="#contact"
              class="btn-primary inline-flex items-center justify-center rounded-full px-7 py-3.5 text-sm font-bold uppercase tracking-[0.16em]"
            >
              Book an Appointment
            </a>
            <a
              href="#services"
              class="btn-secondary inline-flex items-center justify-center rounded-full px-7 py-3.5 text-sm font-bold uppercase tracking-[0.16em]"
            >
              View Services
            </a>
          </div>

          <div class="mt-10 grid gap-4 sm:grid-cols-3">
            {
              stats.map((item) => (
                <div class="feature-stack">
                  <p class="feature-kicker">At a glance</p>
                  <p class="mt-3 font-[var(--font-display)] text-3xl font-semibold leading-none">
                    {item.value}
                  </p>
                  <p class="text-muted mt-3 text-sm leading-6">{item.label}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="relative z-10">
          <div class="hero-shell">
            <div class="hero-media-frame">
              <img
                src="/images/hero-image.webp"
                alt="Doctor with patient in a women’s health clinic"
                class="h-[600px] w-full rounded-[calc(var(--radius-xl)-0.65rem)] object-cover"
              />
            </div>

            <div class="hero-note">
              <p class="eyebrow">Patient-centered care</p>
              <p class="mt-2 font-[var(--font-display)] text-2xl font-semibold leading-tight">
                Thoughtful support through prevention, pregnancy, and lifelong
                wellness.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-shell py-6">
    <div class="location-ribbon grid gap-4 rounded-[var(--radius-lg)] p-4 md:grid-cols-3 md:p-5">
      {
        locations.map((location) => (
          <div class="ribbon-card">
            <p class="eyebrow">Now serving</p>
            <p class="mt-2 font-[var(--font-display)] text-2xl font-semibold">
              {location.name}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="about" class="container-shell py-20">
    <div class="grid items-center gap-14 lg:grid-cols-[0.88fr_1.12fr]">
      <div>
        <div class="portrait-panel">
          <img
            src="/images/dr-carlos-ok.webp"
            alt="Dr. Carlos Rodriguez Ortiz"
            class="h-full w-full rounded-[calc(var(--radius-xl)-0.7rem)] object-cover"
          />
        </div>

        <div class="mt-4 grid grid-cols-3 gap-3">
          <div class="mini-media-card">
            <img
              src="/images/clinic-1.webp"
              alt="Clinic consultation"
              class="h-24 w-full rounded-[1rem] object-cover sm:h-28"
            />
          </div>
          <div class="mini-media-card">
            <img
              src="/images/clinic-2.webp"
              alt="Women’s healthcare visit"
              class="h-24 w-full rounded-[1rem] object-cover sm:h-28"
            />
          </div>
          <div class="mini-media-card">
            <img
              src="/images/clinic-3.webp"
              alt="Patient care in clinic"
              class="h-24 w-full rounded-[1rem] object-cover sm:h-28"
            />
          </div>
        </div>
      </div>

      <div>
        <p class="eyebrow">About Carlos Rodriguez Ortiz MD, PA</p>
        <h2 class="section-heading mt-4">
          Personalized obstetrics and gynecology care for every stage of life.
        </h2>

        <div class="content-columns mt-7 space-y-4">
          <p class="text-muted text-base leading-8">
            Carlos Rodriguez Ortiz MD, PA, and his team specialize in
            obstetrics and gynecology at their offices in Miami and Hialeah,
            HCA Florida Kendall Regional Hospital. Dr. Rodriguez and the
            compassionate team take a patient-focused, integrative approach to
            care, addressing all patient needs in a personal and supportive
            environment.
          </p>

          <p class="text-muted text-base leading-8">
            The practice provides comprehensive care for women through each
            stage of their life, from their first period to pregnancy and
            childbirth to menopause and beyond.
          </p>

          <p class="text-muted text-base leading-8">
            The team manages well-woman exams, birth control, and Pap smears.
            They offer high-quality care for complex health issues as well, such
            as abnormal bleeding, ovarian cysts, and endometriosis.
          </p>

          <p class="text-muted text-base leading-8">
            Through caring and attentive processes, they create clear plans of
            action to help patients achieve their goals and feel confident in
            every decision.
          </p>

          <p class="text-muted text-base leading-8">
            For personalized obstetrics and gynecology care, call Carlos
            Rodriguez Ortiz MD, PA, or schedule an appointment online today.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="mission" class="container-shell py-20">
    <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-start">
      <div class="mission-banner">
        <div class="mission-banner__inner">
          <p class="eyebrow text-[rgb(var(--color-accent-contrast))]">
            Our mission
          </p>
          <h2 class="mt-4 font-[var(--font-display)] text-3xl font-semibold text-white sm:text-4xl">
            Unparalleled patient care with a caring, attentive approach.
          </h2>
          <p class="mt-5 max-w-2xl text-base leading-8 text-white/88">
            Our mission is to deliver compassionate, informed, and personalized
            care for every woman we serve. We listen closely, guide clearly, and
            create care plans that support health, confidence, and comfort at
            every stage of life.
          </p>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
        {
          highlights.map((item) => (
            <div class="info-panel">
              <div class="info-panel__bar"></div>
              <h3 class="font-[var(--font-display)] text-xl font-semibold">
                {item.title}
              </h3>
              <p class="text-muted mt-2 text-sm leading-7">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="services" class="py-20">
    <div class="container-shell">
      <div class="max-w-2xl">
        <p class="eyebrow">Services</p>
        <h2 class="section-heading mt-4">
          Thoughtful women’s health services with a stronger editorial layout.
        </h2>
        <p class="text-muted mt-4 text-base leading-8">
          Preventive, obstetric, and gynecologic care presented in a more
          refined and structured way.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <article class="service-panel">
              <div class="service-panel__image-wrap">
                <img
                  src={service.image}
                  alt={service.title}
                  class="h-56 w-full rounded-[1.35rem] object-cover transition duration-500 hover:scale-[1.04]"
                />
              </div>

              <div class="service-panel__content">
                <p class="service-panel__eyebrow">Women’s health</p>
                <h3 class="mt-3 font-[var(--font-display)] text-2xl font-semibold leading-tight">
                  {service.title}
                </h3>

                <p class="text-muted mt-3 text-sm leading-7">
                  {service.description}
                </p>

                <a
                  href="#contact"
                  class="mt-6 inline-flex text-sm font-bold uppercase tracking-[0.14em] text-[rgb(var(--color-brand))] hover:text-[rgb(var(--color-brand-dark))]"
                >
                  Schedule now →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="insurances" class="container-shell py-20">
    <div class="surface-panel radius-brand-xl p-8 lg:p-12">
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-start">
        <div>
          <p class="eyebrow">Insurances</p>
          <h2 class="section-heading mt-4">
            We accept most insurance providers.
          </h2>
          <p class="text-muted mt-4 text-base leading-8">
            If you have specific questions regarding your coverage, please
            contact us for additional information.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3">
          {
            insuranceProviders.map((provider) => (
              <div class="insurance-tile">
                <img
                  src={provider.src}
                  alt={provider.name}
                  class="rounded-[1rem] object-cover"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="locations" class="container-shell py-20">
    <div class="surface-panel radius-brand-xl overflow-hidden p-8 lg:p-12">
      <div class="max-w-3xl">
        <p class="eyebrow">Locations &amp; contact</p>
        <h2 class="section-heading mt-4">Convenient care, close to home.</h2>
        <p class="text-muted mt-5 text-base leading-8">
          Visit our South Florida offices for attentive obstetric and
          gynecologic care in a calm, welcoming setting.
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          locations.map((location) => (
            <div class="location-panel">
              <div class="location-panel__header">
                <p class="eyebrow">Office location</p>
                <p class="mt-2 font-[var(--font-display)] text-2xl font-semibold">
                  {location.name}
                </p>
                <p class="text-muted mt-3 text-sm leading-7">
                  {location.address} <br /> {location.cityState} {location.zipCode}
                </p>

                <a
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${location.address} ${location.cityState} ${location.zipCode}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-5 inline-flex text-sm font-bold uppercase tracking-[0.14em] text-[rgb(var(--color-brand))] hover:text-[rgb(var(--color-brand-dark))]"
                >
                  Get directions →
                </a>
              </div>

              <div class="location-panel__map">
                <iframe
                  src={location.mapEmbed}
                  title={`Map of ${location.name}`}
                  class="h-[250px] w-full"
                  style="border:0;"
                  loading="lazy"
                  allowfullscreen
                  referrerpolicy="no-referrer-when-downgrade"
                />
              </div>
            </div>
          ))
        }
      </div>

      <div id="contact" class="contact-band mt-10">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="eyebrow text-[rgb(var(--color-accent-contrast))]">
              Request an appointment
            </p>
            <h3 class="mt-4 font-[var(--font-display)] text-3xl font-semibold text-white">
              Start your visit with confidence.
            </h3>
            <p class="mt-4 text-sm leading-7 text-white/84">
              Replace this form with your scheduling tool, patient intake flow,
              or embedded booking widget.
            </p>

            <div class="mt-8 grid gap-3 text-sm text-white/88">
              <p><span class="font-bold text-white">Phone:</span> 786-332-2922</p>
              <p>
                <span class="font-bold text-white">Hours:</span> Mon–Thu 9:00 AM
                – 5:30 PM · Fri 9:00 AM – 2:30 PM
              </p>
              <p>
                <span class="font-bold text-white">Language:</span> Se habla español.
              </p>
            </div>
          </div>

          <form class="grid gap-4" method="POST" data-netlify="true">
            <div class="grid gap-4 sm:grid-cols-2">
              <input type="text" placeholder="Full name" class="contact-input" />
              <input type="email" placeholder="Email" class="contact-input" />
            </div>

            <input type="tel" placeholder="Phone" class="contact-input" />

            <textarea
              rows="5"
              placeholder="How can we help you?"
              class="contact-input"
            ></textarea>

            <button
              type="submit"
              class="inline-flex w-fit items-center justify-center rounded-full bg-white px-7 py-3 text-sm font-bold uppercase tracking-[0.14em] text-[rgb(var(--color-brand-dark))] transition hover:-translate-y-0.5 hover:bg-[rgb(var(--color-surface-soft))]"
            >
              Send Request
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</MainLayout>