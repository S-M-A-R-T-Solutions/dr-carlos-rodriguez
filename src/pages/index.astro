---
import MainLayout from "../layouts/MainLayout.astro";

const services = [
  {
    title: "Well-Woman Exams",
    description:
      "Routine preventive visits focused on screenings, wellness, and long-term gynecologic health for your peace of mind.",
    image: "/images/well-woman-exams.webp",
  },
  {
    title: "Birth Control",
    description:
      "Personalized contraceptive counseling to help patients choose the option that fits their lifestyle and goals.",
    image: "/images/birth-control.webp",
  },
  {
    title: "Pap Smears",
    description:
      "Screening and preventive care designed to support cervical health and early detection.",
    image: "/images/pap-smears.webp",
  },
  {
    title: "Abnormal Bleeding",
    description:
      "Comprehensive evaluation and treatment options for irregular or heavy menstrual bleeding.",
    image: "/images/abnormal-bleeding.webp",
  },
  {
    title: "Ovarian Cysts",
    description:
      "Careful diagnosis and treatment planning for ovarian cysts and related symptoms.",
    image: "/images/ovarian-cysts.webp",
  },
  {
    title: "Endometriosis",
    description:
      "Supportive, individualized care to help manage pain, symptoms, and long-term reproductive health.",
    image: "/images/endometriosis.webp",
  },
  {
    title: "Family Planning",
    description:
      "Guidance and care for patients preparing for pregnancy or planning their reproductive future.",
    image: "/images/family-planning.webp",
  },
  {
    title: "Infertility Services",
    description:
      "Evaluations and next-step guidance for patients seeking support with fertility concerns.",
    image: "/images/infertility-services.webp",
  },
  {
    title: "Prenatal Care",
    description:
      "Attentive pregnancy care focused on the health, comfort, and confidence of both mother and baby.",
    image: "/images/prenatal-care.webp",
  },
  {
    title: "Childbirth Support",
    description:
      "Experienced obstetric care through delivery with a calm and supportive approach.",
    image: "/images/birth-support.webp",
  },
  {
    title: "Menopause Support",
    description:
      "Care plans that help patients navigate hormonal changes, symptoms, and wellness during menopause.",
    image: "/images/menopause-support.webp",
  },
  {
    title: "Hormonal Health",
    description:
      "Evaluation and treatment for hormone-related concerns that affect daily health and quality of life.",
    image: "/images/hormone-health.webp",
  },
];

const highlights = [
  {
    title: "Patient-focused care",
    description:
      "An integrative, personal approach that supports every patient in a warm and attentive environment.",
  },
  {
    title: "Comprehensive women’s health",
    description:
      "Care through every stage of life, from the first period to pregnancy, childbirth, menopause, and beyond.",
  },
  {
    title: "Se habla español",
    description:
      "Bilingual support to help patients feel informed, comfortable, and confident in every step of care.",
  },
];

const stats = [
  { value: "3", label: "South Florida locations" },
  { value: "12+", label: "Women’s health services" },
  { value: "Multiple", label: "Insurances accepted" },
];

const locations = [
  {
    name: "Miami",
    address: "3683 S Miami Ave., Suite 400",
    cityState: "Miami, FL",
    zipCode: "33133",
    mapEmbed:
      "https://www.google.com/maps?q=3683+S+Miami+Ave+Suite+400+Miami+FL+33133&output=embed",
  },
  {
    name: "Hialeah",
    address: "705 E 26th St.",
    cityState: "Hialeah, FL",
    zipCode: "33013",
    mapEmbed:
      "https://www.google.com/maps?q=705+E+26th+St+Hialeah+FL+33013&output=embed",
  },
  {
    name: "Kendall Regional Hospital",
    address: "11760 Bird Rd, Suite 734",
    cityState: "Miami, FL",
    zipCode: "33175",
    mapEmbed:
      "https://www.google.com/maps?q=11760+Bird+Rd+Suite+734+Miami+FL+33175&output=embed",
  },
];

const insuranceProviders = [
  { name: "Aetna", src: "/images/insurances/aetna.webp" },
  {
    name: "AmeriHealth Caritas",
    src: "/images/insurances/amerihealth-caritas.webp",
  },
  {
    name: "Anthem: Blue Cross Blue Shield",
    src: "/images/insurances/anthem-blue-cross-blue-shield.webp",
  },
  { name: "AvMed", src: "/images/insurances/avmed.webp" },
  { name: "Cigna", src: "/images/insurances/cigna.webp" },
  {
    name: "United Healthcare",
    src: "/images/insurances/united-healthcare.webp",
  },
  { name: "Bright Health", src: "/images/insurances/bright-health.webp" },
  {
    name: "Molina Healthcare",
    src: "/images/insurances/molina-healthcare.webp",
  },
  { name: "Oscar", src: "/images/insurances/oscar.webp" },
  { name: "No Insurance? Contact Us", src: "/images/insurances/no-insurance.webp" },
];
---

<MainLayout
  title="Carlos Rodriguez Ortiz MD, PA | Obstetrics & Gynecology"
  description="Compassionate obstetrics and gynecology care in Miami, Hialeah, and Kendall."
>
  <section class="hero-cinematic pt-8 lg:pt-10">
    <div class="hero-cinematic__overlay"></div>
    <div class="hero-pattern"></div>

    <div class="container-shell relative z-10 py-14 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <span class="eyebrow-chip text-white border-white/20 bg-white/10">
            Obstetrics &amp; Gynecology in Miami, Hialeah, and Kendall
          </span>

          <h1
            class="mt-6 max-w-3xl font-[var(--font-display)] text-5xl font-normal leading-[0.95] tracking-[-0.04em] text-white sm:text-6xl lg:text-7xl"
          >
            Women’s healthcare with warmth, elegance, and confidence.
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-white/82">
            Carlos Rodriguez Ortiz MD, PA, and his team provide compassionate
            obstetrics and gynecology care through every stage of life with a
            supportive, patient-first experience.
          </p>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href="#contact"
              class="btn-light inline-flex items-center justify-center rounded-full px-7 py-3.5 text-sm font-bold uppercase tracking-[0.16em]"
            >
              Book an Appointment
            </a>
            <a
              href="#services"
              class="btn-outline-light inline-flex items-center justify-center rounded-full px-7 py-3.5 text-sm font-bold uppercase tracking-[0.16em]"
            >
              View Services
            </a>
          </div>
        </div>

        <div class="relative">
          <div class="hero-side-panel">
            <div class="hero-side-panel__image">
              <img
                src="/images/hero-image-2.webp"
                alt="Doctor with patient in a women’s health clinic"
                class="h-[540px] w-full rounded-[1.7rem] object-cover"
              />
            </div>

            <div class="hero-side-panel__stats">
              {
                stats.map((item) => (
                  <div class="stat-ribbon">
                    <p class="font-[var(--font-display)] text-3xl font-normal leading-none">
                      {item.value}
                    </p>
                    <p class="mt-2 text-sm text-[rgb(var(--color-text-secondary))]">
                      {item.label}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-shell -mt-10 relative z-20">
    <div class="floating-location-band">
      {
        locations.map((location) => (
          <div class="floating-location-band__item">
            <p class="eyebrow">Now serving</p>
            <p class="mt-2 font-[var(--font-display)] text-2xl font-normal">
              {location.name}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="about" class="container-shell py-24">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="stacked-media-layout">
        <div class="stacked-media-layout__main">
          <img
            src="/images/dr-carlos-ok.webp"
            alt="Dr. Carlos Rodriguez Ortiz"
            class="h-full w-full rounded-[1.8rem] object-cover"
          />
        </div>

        <div class="stacked-media-layout__thumb stacked-media-layout__thumb--one">
          <img
            src="/images/clinic-1.webp"
            alt="Clinic consultation"
            class="h-full w-full rounded-[1.3rem] object-cover"
          />
        </div>

        <div class="stacked-media-layout__thumb stacked-media-layout__thumb--two">
          <img
            src="/images/clinic-2.webp"
            alt="Women’s healthcare visit"
            class="h-full w-full rounded-[1.3rem] object-cover"
          />
        </div>

        <div class="stacked-media-layout__thumb stacked-media-layout__thumb--three">
          <img
            src="/images/clinic-3.webp"
            alt="Patient care in clinic"
            class="h-full w-full rounded-[1.3rem] object-cover"
          />
        </div>
      </div>

      <div class="ornament-panel">
        <p class="eyebrow">About Carlos Rodriguez Ortiz MD, PA</p>
        <h2 class="section-heading mt-4">
          Personalized obstetrics and gynecology care for every stage of life.
        </h2>

        <div class="mt-6 space-y-4">
          <p class="text-muted text-base leading-8">
            Carlos Rodriguez Ortiz MD, PA, and his team specialize in obstetrics
            and gynecology at their offices in Miami and Hialeah, HCA Florida
            Kendall Regional Hospital. Dr. Rodriguez and the compassionate team
            take a patient-focused, integrative approach to care, addressing all
            patient needs in a personal and supportive environment.
          </p>

          <p class="text-muted text-base leading-8">
            The practice provides comprehensive care for women through each
            stage of their life, from their first period to pregnancy and
            childbirth to menopause and beyond.
          </p>

          <p class="text-muted text-base leading-8">
            The team manages well-woman exams, birth control, and Pap smears.
            They offer high-quality care for complex health issues as well, such
            as abnormal bleeding, ovarian cysts, and endometriosis. Patients can
            also take advantage of the family planning and infertility services
            available at the practice.
          </p>

          <p class="text-muted text-base leading-8">
            The team’s mission is to deliver unparalleled patient care through a
            caring and attentive process that helps patients feel informed,
            supported, and confident.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="mission" class="immersive-banner-section">
    <div class="immersive-banner-section__overlay"></div>
    <div class="container-shell relative z-10 py-24">
      <div class="max-w-4xl">
        <p class="eyebrow text-[rgb(var(--color-accent-contrast))]">
          Our mission
        </p>
        <h2 class="mt-4 font-[var(--font-display)] text-4xl font-normal leading-[0.98] text-white sm:text-5xl lg:text-6xl">
          Unparalleled patient care in a supportive and attentive environment.
        </h2>
        <p class="mt-6 max-w-3xl text-base leading-8 text-white/82">
          We take time to understand each patient’s unique concerns, create
          personalized plans of action, and guide every step with clarity,
          compassion, and high-quality care.
        </p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          highlights.map((item) => (
            <div class="glass-feature-card">
              <p class="glass-feature-card__title">{item.title}</p>
              <p class="mt-3 text-sm leading-7 text-white/78">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="services" class="container-shell py-24">
    <div >
      <p class="eyebrow">Services</p>
      <h2 class="section-heading mt-4">
        Thoughtful women’s health services with a more expressive presentation.
      </h2>
      <p class="text-muted mt-4 text-base leading-8">
        We provide attentive obstetrics and gynecology care for a wide range of
		concerns, from routine exams to complex health issues, with a more
		elevated and welcoming experience. Explore our services below, and contact us if you have any questions or want to learn more about how we can support your care.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
      {
        services.map((service) => (
          <article class="immersive-service-card transform hover:scale-[1.02] transition duration-300 hover:cursor-pointer">
            <div class="immersive-service-card__image">
              <img
                src={service.image}
                alt={service.title}
                class="h-full w-full object-cover transition duration-700 hover:scale-[1.05]"
              />
              <div class="immersive-service-card__overlay"></div>
            </div>

            <div class="immersive-service-card__content">
              <h3 class="mt-3 font-[var(--font-display)] text-3xl font-normal leading-tight text-white">
                {service.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-white/82">
                {service.description}
              </p>

              <a
                href="#contact"
                class="mt-6 inline-flex text-sm font-bold uppercase tracking-[0.14em] text-white hover:text-[rgb(var(--color-accent-contrast))]"
              >
                Schedule now →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="insurances" class="insurance-showcase-section">
    <div class="container-shell py-24">
      <div class="showcase-panel">
        <div class="showcase-panel__intro">
          <p class="eyebrow">Insurances</p>
          <h2 class="section-heading mt-4">
            We accept most insurance providers.
          </h2>
          <p class="text-muted mt-4 text-base leading-8">
            If you have specific questions regarding your coverage, please
            contact us for additional information.
          </p>
        </div>

        <div class="showcase-panel__grid">
          {
            insuranceProviders.map((provider) => (
              <div class="insurance-badge">
                <img
                  src={provider.src}
                  alt={provider.name}
                  class="rounded-[1rem] object-cover"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="locations" class="container-shell py-24">
    <div class="max-w-3xl">
      <p class="eyebrow">Locations &amp; contact</p>
      <h2 class="section-heading mt-4">Convenient care, close to home.</h2>
      <p class="text-muted mt-5 text-base leading-8">
        Visit our South Florida offices for attentive obstetric and gynecologic
        care in a calm, welcoming setting.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-3">
      {
        locations.map((location) => (
          <div class="story-location-card">
            <div class="story-location-card__map">
              <iframe
                src={location.mapEmbed}
                title={`Map of ${location.name}`}
                class="h-[260px] w-full"
                style="border:0;"
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"
              />
            </div>

            <div class="story-location-card__body">
              <p class="eyebrow">Office location</p>
              <p class="mt-2 font-[var(--font-display)] text-2xl font-normal">
                {location.name}
              </p>
              <p class="text-muted mt-3 text-sm leading-7">
                {location.address} <br /> {location.cityState} {location.zipCode}
              </p>

              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${location.address} ${location.cityState} ${location.zipCode}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex text-sm font-bold uppercase tracking-[0.14em] text-[rgb(var(--color-brand))] hover:text-[rgb(var(--color-brand-dark))]"
              >
                Get directions →
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div id="contact" class="contact-scene mt-12">
      <div class="contact-scene__overlay"></div>

      <div class="grid gap-10 lg:grid-cols-[0.82fr_1.18fr] relative z-10">
        <div>
          <p class="eyebrow text-[rgb(var(--color-accent-contrast))]">
            Request an appointment
          </p>
          <h3 class="mt-4 font-[var(--font-display)] text-4xl font-normal text-white">
            Start your visit with confidence.
          </h3>
          <p class="mt-4 text-sm leading-7 text-white/84">
            Replace this form with your scheduling tool, patient intake flow, or
            embedded booking widget.
          </p>

          <div class="mt-8 space-y-3 text-sm text-white/88">
            <p><span class="font-bold text-white">Phone:</span> 786-332-2922</p>
            <p>
              <span class="font-bold text-white">Hours:</span> Mon–Thu 9:00 AM –
              5:30 PM · Fri 9:00 AM – 2:30 PM
            </p>
            <p>
              <span class="font-bold text-white">Language:</span> Se habla español.
            </p>
          </div>
        </div>

        <form class="contact-form-glass" method="POST" data-netlify="true">
          <input type="text" placeholder="Full name" class="contact-input" />
          <div class="grid gap-4 sm:grid-cols-2">
            <input type="email" placeholder="Email" class="contact-input" />
            <input type="tel" placeholder="Phone" class="contact-input" />
          </div>
          <textarea
            rows="5"
            placeholder="How can we help you?"
            class="contact-input"
          ></textarea>
          <button
            type="submit"
            class="inline-flex w-fit items-center justify-center rounded-full bg-white px-7 py-3 text-sm font-bold uppercase tracking-[0.14em] text-[rgb(var(--color-brand-dark))] transition hover:-translate-y-0.5 hover:bg-[rgb(var(--color-surface-soft))]"
          >
            Send Request
          </button>
        </form>
      </div>
    </div>
  </section>
</MainLayout>