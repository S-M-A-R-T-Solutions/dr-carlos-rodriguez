---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "Carlos Rodriguez Ortiz MD, PA",
  description = "Compassionate obstetrics and gynecology care in Miami, Hialeah, and Kendall.",
  canonical = "https://carlosrodriguezmd.com",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#edf5fc" />

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content="https://carlosrodriguezmd.com/images/hero-image.webp"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://carlosrodriguezmd.com/images/hero-image.webp"
    />
    <meta name="robots" content="index, follow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="/favicon.ico" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Physician",
        name: "Carlos Rodriguez Ortiz MD, PA",
        image: "https://carlosrodriguezmd.com/images/dr-carlos-ok.webp",
        url: "https://carlosrodriguezmd.com/",
        telephone: "+1-786-332-2922",
        medicalSpecialty: ["Obstetrics", "Gynecology"],
        address: [
          {
            "@type": "PostalAddress",
            streetAddress: "3683 S Miami Ave., Suite 400",
            addressLocality: "Miami",
            addressRegion: "FL",
            postalCode: "33133",
            addressCountry: "US",
          },
          {
            "@type": "PostalAddress",
            streetAddress: "705 E 26th St.",
            addressLocality: "Hialeah",
            addressRegion: "FL",
            postalCode: "33013",
            addressCountry: "US",
          },
          {
            "@type": "PostalAddress",
            streetAddress: "11760 Bird Rd, Suite 734",
            addressLocality: "Miami",
            addressRegion: "FL",
            postalCode: "33175",
            addressCountry: "US",
          },
        ],
        openingHoursSpecification: [
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
            opens: "09:00",
            closes: "17:30",
          },
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: "Friday",
            opens: "09:00",
            closes: "14:30",
          },
        ],
        areaServed: ["Miami, FL", "Hialeah, FL", "Kendall, FL"],
      })}
    />

    <script is:inline>
      (() => {
        const storageKey = "clinic-theme";
        const root = document.documentElement;
        const metaTheme = document.querySelector('meta[name="theme-color"]');

        const applyTheme = (theme) => {
          root.classList.remove("light", "dark");
          root.classList.add(theme);
          root.dataset.theme = theme;

          if (metaTheme) {
            metaTheme.setAttribute(
              "content",
              theme === "dark" ? "#071723" : "#edf5fc",
            );
          }
        };

        try {
          const storedTheme = localStorage.getItem(storageKey);
          const initialTheme = storedTheme || "light";
          applyTheme(initialTheme);

          window.__setPreferredTheme = (theme) => {
            localStorage.setItem(storageKey, theme);
            applyTheme(theme);
          };

          window.__getPreferredTheme = () => root.dataset.theme || initialTheme;
        } catch {
          applyTheme("light");
        }
      })();
    </script>
  </head>

  <body
    class="bg-[rgb(var(--color-bg))] text-[rgb(var(--color-text))] font-[var(--font-body)] antialiased transition-colors duration-300"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-[rgb(var(--color-surface))] focus:px-4 focus:py-2 focus:text-[rgb(var(--color-text))]"
    >
      Skip to content
    </a>

    <div
      class="relative min-h-screen overflow-x-clip bg-[rgb(var(--color-bg))]"
    >
      <div
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[42rem] hero-glow"
      >
      </div>

      <Header />

      <main id="main-content" class="relative">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>
