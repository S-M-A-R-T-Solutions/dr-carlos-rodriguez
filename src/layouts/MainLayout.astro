---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Carlos Rodriguez Ortiz MD, PA",
  description = "Compassionate obstetrics and gynecology care in Miami, Hialeah, and Kendall.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://carlosrodriguezmd.com/" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://carlosrodriguezmd.com/" />
    <meta property="og:image" content="https://carlosrodriguezmd.com/images/dr-carlos-ok.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context":"https://schema.org","@type":"MedicalClinic",
      "@id":"https://carlosrodriguezmd.com/#clinic",
      name:"Carlos Rodriguez Ortiz MD, PA",url:"https://carlosrodriguezmd.com/",
      image:"https://carlosrodriguezmd.com/images/dr-carlos-ok.webp",
      telephone:"+1-786-332-2922",medicalSpecialty:"Obstetric",availableLanguage:["English","Spanish"],
      department:[
        { "@type":"MedicalClinic", name:"Miami office",address:{"@type":"PostalAddress",streetAddress:"3683 S Miami Ave, Suite 400",addressLocality:"Miami",addressRegion:"FL",postalCode:"33133",addressCountry:"US"}},
        { "@type":"MedicalClinic", name:"Hialeah office",address:{"@type":"PostalAddress",streetAddress:"705 E 26th St",addressLocality:"Hialeah",addressRegion:"FL",postalCode:"33013",addressCountry:"US"}},
        { "@type":"MedicalClinic", name:"Kendall office",address:{"@type":"PostalAddress",streetAddress:"11760 Bird Rd, Suite 734",addressLocality:"Miami",addressRegion:"FL",postalCode:"33175",addressCountry:"US"}}
      ]
    })} />
    <meta name="theme-color" content="#f6f9fa" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (() => {
        const storageKey = "clinic-theme";
        const root = document.documentElement;
        const metaTheme = document.querySelector('meta[name="theme-color"]');

        const getSystemTheme = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";

        const applyTheme = (theme) => {
          root.classList.remove("light", "dark");
          root.classList.add(theme);
          root.dataset.theme = theme;

          if (metaTheme) {
            metaTheme.setAttribute(
              "content",
              theme === "dark" ? "#09151c" : "#f6f9fa",
            );
          }
        };

        try {
          const storedTheme = localStorage.getItem(storageKey);
          const initialTheme = storedTheme || getSystemTheme();
          applyTheme(initialTheme);

          window.__setPreferredTheme = (theme) => {
            localStorage.setItem(storageKey, theme);
            applyTheme(theme);
          };

          window.__getPreferredTheme = () => root.dataset.theme || initialTheme;

          window
            .matchMedia("(prefers-color-scheme: dark)")
            .addEventListener("change", (event) => {
              const stored = localStorage.getItem(storageKey);
              if (!stored) {
                applyTheme(event.matches ? "dark" : "light");
              }
            });
        } catch {
          applyTheme("light");
        }
      })();
    </script>
  </head>

  <body
    class="bg-[rgb(var(--color-bg))] text-[rgb(var(--color-text))] font-[var(--font-body)] antialiased transition-colors duration-300"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-[rgb(var(--color-surface))] focus:px-4 focus:py-2 focus:text-[rgb(var(--color-text))]"
    >
      Skip to content
    </a>

    <div
      class="relative min-h-screen overflow-x-clip bg-[rgb(var(--color-bg))]"
    >
      <div
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem] hero-glow"
      >
      </div>

      <Header />

      <main id="main-content" class="relative">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>
